# LLM API Keys (comma-separated keys, mapped in order to key_1, key_2, ...)
LLM_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2

# LLM Model (default: gemini/gemini-2.0-flash)
LLM_MODEL=gemini/gemini-2.0-flash

# SQLite Database URL (e.g. sqlite:///./data/app.db or sqlite:////data/app.db for Docker)
DATABASE_URL=sqlite:///./data/app.db

# Allowed CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000

# Failure simulation toggle for X-Simulate-Failure header (default: true)
ENABLE_FAILURE_SIMULATION=true
